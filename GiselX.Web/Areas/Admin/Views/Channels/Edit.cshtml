@model GiselX.Service.Dto.ChannelDto
@{
    ViewData["Title"] = Model.Id > 0 ? "Edit Channel" : "Add Channel";
    Layout = "_ContentNavbarLayout";
}

<div class="card">
    <div class="card-header"><h5 class="mb-0">@ViewData["Title"]</h5></div>
    <div class="card-body">
        <form asp-action="Save" method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" maxlength="50" />
                <span asp-validation-for="Code" class="text-danger"></span>
                <small class="text-muted">
                    @(Model.Id > 0
                        ? "Change this only if you need a custom code. It must stay unique."
                        : "Generated automatically. Change it only if you need a custom code.")
                </small>
            </div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" maxlength="200" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="IsActive" class="form-label"></label>
                <select asp-for="IsActive" class="form-select">
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Save Channel</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
