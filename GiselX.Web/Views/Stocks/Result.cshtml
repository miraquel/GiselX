@using GiselX.Domain
@model GiselX.Service.Dto.StockUploadBatchDto
@{ ViewData["Title"] = "Stock Upload Result"; Layout = "_ContentNavbarLayout"; }
<div class="card"><div class="card-header d-flex justify-content-between"><h5>Stock Upload Result</h5><a asp-action="Index" class="btn btn-outline-secondary">Back to Stock</a></div><div class="card-body">
    <div class="alert @(Model.Status == StockUploadBatchStatus.Failed ? "alert-danger" : Model.Status == StockUploadBatchStatus.CompletedWithWarnings ? "alert-warning" : "alert-success")">@Model.Message</div>
    <dl class="row"><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Model.Status</dd><dt class="col-sm-4">Stock date</dt><dd class="col-sm-8">@Model.StockDate.ToString("yyyy-MM-dd")</dd><dt class="col-sm-4">File</dt><dd class="col-sm-8">@Model.OriginalFileName</dd><dt class="col-sm-4">Rows</dt><dd class="col-sm-8">@Model.TotalRows total, @Model.ValidRows published, @Model.InvalidRows invalid</dd><dt class="col-sm-4">Uploaded</dt><dd class="col-sm-8">@Model.UploadedDate.ToString("yyyy-MM-dd HH:mm") by @Model.UploadedBy</dd></dl>
    @if (Model.IgnoredSummaryRowNumbers.Count > 0) { <p><strong>Ignored summary rows:</strong> @string.Join(", ", Model.IgnoredSummaryRowNumbers)</p> }
    @if (Model.Errors.Count > 0) { <h6>Invalid row details</h6><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Worksheet</th><th>Row</th><th>Field</th><th>Reason</th><th>Value</th></tr></thead><tbody>@foreach(var error in Model.Errors){<tr><td>@error.WorksheetName</td><td>@error.SourceRowNumber</td><td>@error.Field</td><td>@error.Reason</td><td>@error.RejectedValue</td></tr>}</tbody></table></div> }
</div></div>
