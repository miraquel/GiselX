@model GiselX.Service.Dto.StockAreaDto
@{
    ViewData["Title"] = Model.Id > 0 ? "Edit Area" : "Add Area";
    Layout = "_ContentNavbarLayout";
}

<div class="card">
    <div class="card-header"><h5 class="mb-0">@ViewData["Title"] — @ViewBag.CompanyName</h5></div>
    <div class="card-body">
        <form asp-action="Save" method="post">
            <input asp-for="Id" type="hidden" />
            <input asp-for="CompanyId" type="hidden" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Area Name</label>
                <input asp-for="Name" class="form-control" maxlength="100" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Aliases" class="form-label">Aliases</label>
                <textarea asp-for="Aliases" class="form-control" rows="2" maxlength="1000"
                          placeholder="MDN; Gudang Medan"></textarea>
                <div class="form-text">
                    Other spellings the distributor uses for this area in their workbook. Separate
                    with <code>;</code>. Matching ignores case and extra spaces, and a name or alias
                    cannot be shared with another area of this company.
                </div>
                <span asp-validation-for="Aliases" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="IsActive" class="form-label"></label>
                <select asp-for="IsActive" class="form-select">
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Save Area</button>
            <a asp-action="Index" asp-route-companyId="@Model.CompanyId" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
