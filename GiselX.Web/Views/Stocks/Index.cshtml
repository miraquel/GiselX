@using GiselX.Common.Constants
@model GiselX.Web.Models.StockIndexViewModel
@{ ViewBag.Title = "Stock"; }

@section styles {
    <link href="/lib/datatables-bs5/datatables.boostrap5.css" rel="stylesheet" />
    <link href="/lib/datatables-responsive-bs5/responsive.bootstrap5.css" rel="stylesheet" />
}

<div class="card">
    <div class="card-header">
        <h4 class="card-title">Stock</h4>
        @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
        <div class="row g-3 align-items-end">
            @if (User.HasClaim("permission", PermissionConstants.Stocks.Upload))
            {
                <div class="col-lg-7">
                    <form id="stockUploadForm" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="input-group">
                            <input type="date" name="stockDate" id="stockDate" class="form-control" required />
                            <input type="file" name="file" id="stockFile" class="form-control" accept=".xlsx" required />
                            <button type="submit" class="btn btn-outline-success"><span class="ri-upload-2-fill me-1"></span>Review Upload</button>
                        </div>
                    </form>
                </div>
            }
            @if (User.HasClaim("permission", PermissionConstants.Stocks.Download))
            {
                <div class="col-lg-5">
                    <form asp-action="DownloadBatch" method="get" class="input-group">
                        <select name="batchId" class="form-select" required>
                            <option value="">Select uploaded snapshot</option>
                            @foreach (var upload in Model.CompletedUploads) { <option value="@upload.BatchId">@upload.DisplayText</option> }
                        </select>
                        <button class="btn btn-outline-primary"><span class="ri-download-2-fill me-1"></span>Download</button>
                    </form>
                </div>
            }
        </div>
    </div>
    <div class="card-datatable text-nowrap">
        <table id="stock-table" class="table table-bordered" style="width:100%"><thead><tr>
            <th>Product ID</th><th>Product Name</th><th>Packaging</th><th>Pcs/Ctn</th><th>Netto</th><th>Unit</th><th>Price Unit</th>
            <th>Saldo Awal</th><th>Saldo Masuk PO</th><th>Saldo Akhir</th><th>Batch No</th><th>Expired Date</th><th>Stock Date</th>
        </tr></thead></table>
    </div>
</div>

<div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">Review Stock upload</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
        <div id="reviewAlert" class="alert d-none"></div>
        <dl class="row mb-3"><dt class="col-sm-5">Detected mapping</dt><dd class="col-sm-7" id="mappingName"></dd><dt class="col-sm-5">Stock date</dt><dd class="col-sm-7" id="reviewStockDate"></dd><dt class="col-sm-5">Rows</dt><dd class="col-sm-7" id="rowCounts"></dd><dt class="col-sm-5">Ignored summary rows</dt><dd class="col-sm-7" id="ignoredRows"></dd></dl>
        <h6>Validation details</h6><ul id="validationDetails" class="mb-0"></ul>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-success" id="confirmUpload">Confirm and Upload</button></div>
</div></div></div>

@section scripts {
<script src="/lib/jquery/dist/jquery.min.js"></script>
<script src="/lib/datatables-bs5/datatables.bootstrap5.js"></script>
<script src="/lib/moment/moment.js"></script>
<script src="/js/helper.js"></script>
<script>
$(function () {
 const form = document.getElementById('stockUploadForm');
 const modalElement = document.getElementById('reviewModal');
 const modal = modalElement ? new bootstrap.Modal(modalElement) : null;
 const token = form?.querySelector('[name="__RequestVerificationToken"]')?.value;
 const table = $('#stock-table').DataTable({
   processing:true, serverSide:true, searching:true, ordering:true, scrollX:true, order:[[0,'asc']],
   ajax:{
     url:'/api/Stocks/Select',
     data:function(d){
       const q={pageNumber:(d.start/d.length)+1,pageSize:d.length};
       if(d.search?.value){q.SearchTerm=d.search.value;}
       if(d.order?.length){q.SortBy=d.columns[d.order[0].column].data;q.IsSortAscending=d.order[0].dir==='asc';}
       return q;
     },
     dataSrc:function(json){ if(json.data?.items){json.recordsTotal=json.data.totalCount;json.recordsFiltered=json.data.totalCount;return json.data.items;} return []; }
   },
   columns:[
    {data:'productId'},{data:'productName'},{data:'productPackaging'},{data:'productPcsInCtn'},
    {data:'productNetto'},{data:'productUnit'},{data:'priceUnit'},{data:'saldoAwal'},{data:'saldoMasukPO'},
    {data:'saldoAkhir'},{data:'batchNumber'},
    {data:'expiredDate',render:d=>d&&d.substring(0,10)!=='1753-01-01'?moment(d).format('DD MMM YYYY'):''},
    {data:'stockDate',render:d=>d?moment(d).format('DD MMM YYYY'):''}
   ]
 });
 function render(preflight, message) {
   $('#mappingName').text(preflight.mappingName || 'Not detected'); $('#reviewStockDate').text(preflight.stockDate?.substring(0,10) || '');
   $('#rowCounts').text(`${preflight.totalRows} total, ${preflight.validRows} valid, ${preflight.invalidRows} invalid`);
   $('#ignoredRows').text(preflight.ignoredSummaryRowNumbers?.join(', ') || 'None');
   const details=$('#validationDetails').empty(); (preflight.errors||[]).forEach(e=>details.append($('<li>').text(e)));
   (preflight.rowErrors||[]).forEach(e=>details.append($('<li>').text(`Row ${e.sourceRowNumber}${e.field!==null&&e.field!==undefined?' — '+e.field:''}: ${e.reason}`)));
   if(!details.children().length) details.append($('<li>').text('All rows are valid.'));
   $('#reviewAlert').removeClass('d-none alert-success alert-warning alert-danger').addClass(preflight.canPublish?(preflight.invalidRows?'alert-warning':'alert-success'):'alert-danger').text(message||'Review complete.');
   $('#confirmUpload').prop('disabled',!preflight.canPublish); modal.show();
 }
 form?.addEventListener('submit', async e => { e.preventDefault(); const response=await fetch('@Url.Action("PreflightUpload")',{method:'POST',body:new FormData(form),headers:{RequestVerificationToken:token}}); const body=await response.json(); if(body.data) render(body.data,body.message); else alert(body.message||'Unable to analyze workbook.'); });
 $('#confirmUpload').on('click', async function(){ this.disabled=true; const data=new FormData(form); data.append('confirmed','true'); const response=await fetch('@Url.Action("Upload")',{method:'POST',body:data,headers:{RequestVerificationToken:token}}); const body=await response.json(); if(body.data?.batchId){window.location.href='@Url.Action("Result")?batchId='+body.data.batchId;return;} alert(body.message||'Upload failed.'); this.disabled=false; });
});
</script>
}
