@model GiselX.Service.UploadLinkReadinessReport
@{
    ViewData["Title"] = "Test Email Notification";
    Layout = "_ContentNavbarLayout";
}

@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["StatusMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card mb-4">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="mb-0">Email Link Readiness</h5>
        <small class="text-muted float-end">Checked live, every time this page loads</small>
    </div>
    <div class="card-body">
        <p class="text-muted">
            An upload notification omits a link rather than sending a broken one, so a missing download
            link looks identical to a fault. These are the two things that have to be true before one
            appears &mdash; checked against this server right now, not against what the configuration claims.
        </p>

        <div class="table-responsive mb-4">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th style="width: 1%;">Status</th>
                        <th style="width: 20%;">Requirement</th>
                        <th>Detail</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var requirement in Model.Requirements)
                {
                    <tr>
                        <td>
                            @if (requirement.IsMet)
                            {
                                <span class="badge bg-label-success text-nowrap">Ready</span>
                            }
                            else
                            {
                                <span class="badge bg-label-danger text-nowrap">Missing</span>
                            }
                        </td>
                        <td class="fw-medium">@requirement.Name</td>
                        <td>
                            <div style="overflow-wrap: anywhere;">@requirement.Detail</div>
                            @if (requirement.Action is not null)
                            {
                                <small class="text-warning d-block mt-1">@requirement.Action</small>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (!Model.DownloadLinksPossible)
        {
            <div class="alert alert-warning mb-4">
                Until both rows above read <strong>Ready</strong>, no upload &mdash; however recent &mdash;
                will produce a download link.
                <a asp-area="Admin" asp-controller="EmailSettings" asp-action="Index">Open Email Settings</a>
                to set the dashboard address; the archive folder is set with the
                <code>UploadArchive__Path</code> environment variable and needs an application restart.
            </div>
        }

        <h6 class="mb-2">What a notification sent right now would contain</h6>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th style="width: 12%;">Upload</th>
                        <th>Latest completed upload</th>
                        <th style="width: 34%;">Links in the mail</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var sample in Model.Samples)
                {
                    <tr>
                        <td class="fw-medium text-nowrap">@sample.Kind</td>
                        <td>
                            @if (sample.Reference is not null)
                            {
                                <div style="overflow-wrap: anywhere;">
                                    <span class="fw-medium">#@sample.Reference</span>
                                    &mdash; @sample.OriginalFileName
                                    @if (sample.BelongsToAnotherCompany)
                                    {
                                        <span class="badge bg-label-secondary ms-1">Another distributor</span>
                                    }
                                </div>
                            }
                            <small class="text-muted d-block mt-1">@sample.Diagnosis</small>
                        </td>
                        <td>
                            @if (sample.ResultLink is null && sample.DownloadLink is null)
                            {
                                <span class="text-muted">None</span>
                            }
                            @if (sample.ResultLink is not null)
                            {
                                <div class="mb-1" style="overflow-wrap: anywhere;">
                                    <span class="badge bg-label-primary">Result</span>
                                    <a href="@sample.ResultLink" target="_blank" rel="noopener">@sample.ResultLink</a>
                                </div>
                            }
                            @if (sample.DownloadLink is not null)
                            {
                                <div style="overflow-wrap: anywhere;">
                                    @if (sample.FileOnDisk)
                                    {
                                        <span class="badge bg-label-success">Download</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-label-warning">Download (file gone)</span>
                                    }
                                    <a href="@sample.DownloadLink" target="_blank" rel="noopener">@sample.DownloadLink</a>
                                </div>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <small class="text-muted">
            Click a link to prove it end to end. Both pages require a login and are scoped to the
            reader's own company &mdash; which is what makes a forwarded notification harmless, and also
            why a link to another distributor's upload will turn you away rather than open.
        </small>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="mb-0">Test Email Notification</h5>
        <small class="text-muted float-end">Send a test reminder email to verify SMTP configuration</small>
    </div>
    <div class="card-body">
        <form asp-action="Send" method="post">
            @Html.AntiForgeryToken()

            <div class="row mb-4">
                <label for="toEmail" class="col-sm-3 col-form-label">Recipient Email</label>
                <div class="col-sm-9">
                    <input type="text" id="toEmail" name="toEmail" class="form-control"
                           value="@ViewBag.ToEmail" placeholder="recipient@example.com" required />
                    <small class="text-muted">Recipient(s). Separate multiple addresses with <code>;</code>.</small>
                </div>
            </div>

            <div class="row mb-4">
                <label for="companyName" class="col-sm-3 col-form-label">Company Name</label>
                <div class="col-sm-9">
                    <input type="text" id="companyName" name="companyName" class="form-control"
                           placeholder="e.g. PT Maju Jaya" required />
                    <small class="text-muted">Used to personalise the email subject and body.</small>
                </div>
            </div>

            <div class="row mb-4">
                <label for="deadline" class="col-sm-3 col-form-label">Deadline Date</label>
                <div class="col-sm-9">
                    <input type="date" id="deadline" name="deadline" class="form-control"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
            </div>

            <div class="row mb-4">
                <label class="col-sm-3 col-form-label">Reminder Type</label>
                <div class="col-sm-9 pt-2">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="isFinalReminder"
                               id="typeEarly" value="false" checked />
                        <label class="form-check-label" for="typeEarly">
                            Early Warning
                            <small class="text-muted d-block">Subject: [Reminder] Data upload due in N days</small>
                        </label>
                    </div>
                    <div class="form-check form-check-inline ms-4">
                        <input class="form-check-input" type="radio" name="isFinalReminder"
                               id="typeFinal" value="true" />
                        <label class="form-check-label" for="typeFinal">
                            Final Reminder
                            <small class="text-muted d-block">Subject: [Action Required] Deadline is today</small>
                        </label>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-9 offset-sm-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="ri-mail-send-line me-1"></i> Send Test Reminder
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="mb-0">Test Upload Notification</h5>
        <small class="text-muted float-end">Send a sample upload confirmation</small>
    </div>
    <div class="card-body">
        <p class="text-muted">
            Sends the confirmation a distributor receives after a completed upload. Nothing is uploaded
            and no batch is created: the sample is addressed to your most recent completed upload of the
            chosen type, so the links it carries are the live ones shown above. When there is no such
            upload it falls back to illustrative figures and no links.
        </p>
        <form asp-action="SendUploadNotification" method="post">
            @Html.AntiForgeryToken()

            <div class="row mb-4">
                <label for="notifyToEmail" class="col-sm-3 col-form-label">Recipient Email</label>
                <div class="col-sm-9">
                    <input type="text" id="notifyToEmail" name="toEmail" class="form-control"
                           value="@ViewBag.ToEmail" placeholder="admin@distributor.co.id; gudang@distributor.co.id" required />
                    <small class="text-muted">Separate multiple addresses with <code>;</code>.</small>
                </div>
            </div>

            <div class="row mb-4">
                <label for="notifyCompanyName" class="col-sm-3 col-form-label">Company Name</label>
                <div class="col-sm-9">
                    <input type="text" id="notifyCompanyName" name="companyName" class="form-control"
                           placeholder="e.g. Anak Mas" required />
                    <small class="text-muted">Shown as the greeting, the way a real distributor would see it.</small>
                </div>
            </div>

            <div class="row mb-4">
                <label for="kind" class="col-sm-3 col-form-label">Upload Type</label>
                <div class="col-sm-9">
                    <select id="kind" name="kind" class="form-select">
                        <option value="Stock">Stock</option>
                        <option value="Sellout">Sellout</option>
                        <option value="ServiceLevel">Service Level</option>
                    </select>
                    <small class="text-muted">
                        Stock omits the outlet count it has no data for; Service Level omits the period too.
                    </small>
                </div>
            </div>

            <div class="row mb-4">
                <label class="col-sm-3 col-form-label">Outcome</label>
                <div class="col-sm-9 pt-2">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="withRejectedRows"
                               id="outcomeClean" value="false" checked />
                        <label class="form-check-label" for="outcomeClean">
                            Fully successful
                            <small class="text-muted d-block">Status: &#9989; Berhasil</small>
                        </label>
                    </div>
                    <div class="form-check form-check-inline ms-4">
                        <input class="form-check-input" type="radio" name="withRejectedRows"
                               id="outcomePartial" value="true" />
                        <label class="form-check-label" for="outcomePartial">
                            Partially accepted
                            <small class="text-muted d-block">Status: &#9888;&#65039; Berhasil sebagian</small>
                        </label>
                    </div>
                    <small class="text-muted d-block mt-2">
                        Applies to the illustrative sample only. A sample addressed to a real upload
                        reports that upload's own figures.
                    </small>
                </div>
            </div>

            <div class="row mb-4">
                <label class="col-sm-3 col-form-label">Download Link</label>
                <div class="col-sm-9 pt-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="forceDownloadLink"
                               id="forceDownloadLink" value="true" />
                        <label class="form-check-label" for="forceDownloadLink">
                            Force the download line in even when the workbook was not archived
                            <small class="text-muted d-block">
                                For reviewing the wording and layout before any upload has been archived.
                                The link itself will report the file as unavailable, because that upload
                                predates the archive and its workbook was never kept.
                            </small>
                        </label>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-9 offset-sm-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="ri-mail-send-line me-1"></i> Send Sample Notification
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
