@model GiselX.Web.Models.MappingCopyResultViewModel
@{
    ViewData["Title"] = "Copy Mappings";
    Layout = "_ContentNavbarLayout";
    var result = Model.Result;
}
<div class="card">
    <div class="card-header">
        <h5 class="mb-1">Copy Mappings</h5>
        <small class="text-muted">Result for <strong>@Model.TargetCompanyName</strong></small>
    </div>
    <div class="card-body">
        <div class="alert alert-success">@Model.Message</div>
        <ul>
            <li>Sellout template mappings copied: <strong>@result.SelloutCopied</strong></li>
            <li>Stock template mappings copied: <strong>@result.StockCopied</strong></li>
            <li>Item mappings copied: <strong>@result.ItemMappingsCopied</strong>
                @if (result.ItemMappingsSkipped > 0) { <span class="text-muted">(@result.ItemMappingsSkipped skipped, already mapped)</span> }</li>
        </ul>
        @if (result.Skipped.Count > 0)
        {
            <h6>Not copied</h6>
            <ul class="text-muted">
                @foreach (var line in result.Skipped) { <li>@line</li> }
            </ul>
        }
        <a asp-controller="Companies" asp-action="Edit" asp-route-id="@Model.TargetCompanyId" class="btn btn-primary">Back to company</a>
    </div>
</div>
