@using GiselX.Common.Constants
@model GiselX.Service.Dto.SalesTransactionDto

@{
    ViewBag.Title = "Sales Transaction";
}

@section styles
{
    <link href="/lib/datatables-bs5/datatables.boostrap5.css" rel="stylesheet" type="text/css" />
    <link href="/lib/datatables-responsive-bs5/responsive.bootstrap5.css" rel="stylesheet" type="text/css" />
    <link href="/lib/datatables-buttons-bs5/buttons.boostrap5.css" rel="stylesheet" type="text/css" />
    <link href="/lib/datatables-rowgroup-bs5/rowgroup.bootstrap5.css" rel="stylesheet" type="text/css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="/lib/select2-bootstrap-5-theme/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
}

@Html.AntiForgeryToken()

<div class="card">
    <div class="card-header">
        <h4 class="card-title">Sales Transaction</h4>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="card-tools">
            @if (User.HasClaim("permission", PermissionConstants.SalesTransactions.Upload))
            {
                <form id="selloutUploadForm" asp-controller="SalesTransactions" asp-action="Upload" method="post" enctype="multipart/form-data">
                    <input type="hidden" id="multiWeekConfirmed" name="multiWeekConfirmed" value="false" />
                    <input type="hidden" id="confirmedSha256" name="confirmedSha256" value="" />
                    <div class="input-group">
                        <input type="file" id="fileInput" name="file" class="form-control" aria-describedby="fileInputAddon" aria-label="Upload" accept=".xlsx,.xls,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel" required>
                        <button type="submit" class="btn btn-outline-success material-shadow-none" id="fileInputAddon">
                            <span class="ri-upload-2-fill me-1"></span>
                            Upload
                        </button>
                    </div>
                </form>
            }
        </div>
        <div class="row mt-4">
            <div class="col-md-6">
                <select id="yearSelect" name="year" class="form-control"></select>
            </div>
            <div class="col-md-6">
                <select id="monthSelect" name="month" class="form-control"></select>
            </div>
        </div>
        <div class="mt-4">
            <div class="d-flex justify-content-between align-items-center mb-2"><h6 class="mb-0">Selected data summary</h6><small class="text-muted">@(User.IsInRole("Administrator") ? "Updates with period, distributor, search, and column filters" : "Updates with period, search, and column filters")</small></div>
            <div class="row g-2" id="salesSelectionSummary">
                @if (User.IsInRole("Administrator"))
                {
                    <div class="col-6 col-lg-4 col-xl-2"><div class="border rounded p-2"><small class="text-muted">Distributors</small><div class="fs-5 fw-semibold" id="salesSummaryDistributors">—</div></div></div>
                }
                <div class="col-6 col-lg-4 col-xl-2"><div class="border rounded p-2"><small class="text-muted">Rows</small><div class="fs-5 fw-semibold" id="salesSummaryRows">—</div></div></div>
                <div class="col-6 col-lg-4 col-xl-2"><div class="border rounded p-2"><small class="text-muted">Invoice quantity</small><div class="fs-5 fw-semibold" id="salesSummaryQty">—</div></div></div>
                <div class="col-6 col-lg-4 col-xl-2"><div class="border rounded p-2"><small class="text-muted">Gross value</small><div class="fs-5 fw-semibold" id="salesSummaryGross">—</div></div></div>
                <div class="col-6 col-lg-4 col-xl-2"><div class="border rounded p-2"><small class="text-muted">Discount</small><div class="fs-5 fw-semibold" id="salesSummaryDiscount">—</div></div></div>
                <div class="col-6 col-lg-4 col-xl-2"><div class="border rounded p-2"><small class="text-muted">Net value</small><div class="fs-5 fw-semibold" id="salesSummaryNet">—</div></div></div>
            </div>
        </div>
    </div>
    <div class="card-datatable text-nowrap">
        <table id="salestransaction-table" class="datatables-basic table table-bordered" style="width: 100%;">
            <thead>
            <tr>
                @if (User.IsInRole("Administrator")) { <th>@Html.DisplayNameFor(m => m.CompanyName)</th> }
                <th>@Html.DisplayNameFor(m => m.InvoiceNo)</th>
                <th>@Html.DisplayNameFor(m => m.InvoiceDate)</th>
                <th>@Html.DisplayNameFor(m => m.CustomerId)</th>
                <th>@Html.DisplayNameFor(m => m.CustomerName)</th>
                <th>@Html.DisplayNameFor(m => m.ProductId)</th>
                <th>@Html.DisplayNameFor(m => m.ProductBrand)</th>
                <th>@Html.DisplayNameFor(m => m.ProductName)</th>
                <th>@Html.DisplayNameFor(m => m.ProductPackaging)</th>
                <th>@Html.DisplayNameFor(m => m.BatchNumber)</th>
                <th>@Html.DisplayNameFor(m => m.ExpiredDate)</th>
                <th>@Html.DisplayNameFor(m => m.InvoiceQty)</th>
                <th>@Html.DisplayNameFor(m => m.InvoiceUnit)</th>
                <th>@Html.DisplayNameFor(m => m.UnitPrice)</th>
                <th>@Html.DisplayNameFor(m => m.GrossValue)</th>
                <th>@Html.DisplayNameFor(m => m.DiscountValue)</th>
                <th>@Html.DisplayNameFor(m => m.DiscountPct)</th>
                <th>@Html.DisplayNameFor(m => m.NetValue)</th>
                <th>@Html.DisplayNameFor(m => m.InKg)</th>
                <th>@Html.DisplayNameFor(m => m.ShipDate)</th>
                <th>@Html.DisplayNameFor(m => m.SalesmanNameGMK)</th>
            </tr>
            </thead>
            <tfoot>
                @if (User.IsInRole("Administrator")) { <th>@Html.DisplayNameFor(m => m.CompanyName)</th> }
                <th>@Html.DisplayNameFor(m => m.InvoiceNo)</th>
                <th>@Html.DisplayNameFor(m => m.InvoiceDate)</th>
                <th>@Html.DisplayNameFor(m => m.CustomerId)</th>
                <th>@Html.DisplayNameFor(m => m.CustomerName)</th>
                <th>@Html.DisplayNameFor(m => m.ProductId)</th>
                <th>@Html.DisplayNameFor(m => m.ProductBrand)</th>
                <th>@Html.DisplayNameFor(m => m.ProductName)</th>
                <th>@Html.DisplayNameFor(m => m.ProductPackaging)</th>
                <th>@Html.DisplayNameFor(m => m.BatchNumber)</th>
                <th>@Html.DisplayNameFor(m => m.ExpiredDate)</th>
                <th>@Html.DisplayNameFor(m => m.InvoiceQty)</th>
                <th>@Html.DisplayNameFor(m => m.InvoiceUnit)</th>
                <th>@Html.DisplayNameFor(m => m.UnitPrice)</th>
                <th>@Html.DisplayNameFor(m => m.GrossValue)</th>
                <th>@Html.DisplayNameFor(m => m.DiscountValue)</th>
                <th>@Html.DisplayNameFor(m => m.DiscountPct)</th>
                <th>@Html.DisplayNameFor(m => m.NetValue)</th>
                <th>@Html.DisplayNameFor(m => m.InKg)</th>
                <th>@Html.DisplayNameFor(m => m.ShipDate)</th>
                <th>@Html.DisplayNameFor(m => m.SalesmanNameGMK)</th>
            </tfoot>
        </table>
    </div>
</div>

<div class="modal fade" id="selloutUploadPreviewModal" tabindex="-1" aria-labelledby="selloutUploadPreviewTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="selloutUploadPreviewTitle">Sellout upload summary</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="uploadPreviewMessage" class="alert d-none" role="alert"></div>
                <div class="row g-3 mb-4">
                    <div class="col-sm-6 col-xl-3"><div class="border rounded p-3 h-100"><div class="text-muted small">Total transaction rows</div><div class="fs-3 fw-semibold" id="previewTotalRows">0</div></div></div>
                    <div class="col-sm-6 col-xl-3"><div class="border border-success rounded p-3 h-100"><div class="text-success small">Ready to publish</div><div class="fs-3 fw-semibold text-success" id="previewValidRows">0</div></div></div>
                    <div class="col-sm-6 col-xl-3"><div class="border border-danger rounded p-3 h-100"><div class="text-danger small">Invalid rows</div><div class="fs-3 fw-semibold text-danger" id="previewInvalidRows">0</div></div></div>
                    <div class="col-sm-6 col-xl-3"><div class="border rounded p-3 h-100"><div class="text-muted small">Ignored summary rows</div><div class="fs-3 fw-semibold" id="previewIgnoredRowCount">0</div></div></div>
                </div>
                <div class="row g-4 mb-4">
                    <div class="col-lg-6">
                        <h6 class="mb-3">Upload information</h6>
                        <dl class="row mb-0">
                            <dt class="col-sm-4">File</dt><dd class="col-sm-8 text-break" id="previewFileName">-</dd>
                            <dt class="col-sm-4">Detected mapping</dt><dd class="col-sm-8" id="previewMapping">-</dd>
                            <dt class="col-sm-4">Ignored row numbers</dt><dd class="col-sm-8" id="previewIgnoredRows">None</dd>
                        </dl>
                    </div>
                    <div class="col-lg-6">
                        <h6 class="mb-3">Sellout totals from valid rows</h6>
                        <div class="table-responsive"><table class="table table-sm table-bordered mb-0"><tbody>
                            <tr><th>Invoice quantity</th><td class="text-end fw-semibold" id="previewInvoiceQty">0</td></tr>
                            <tr><th>Gross value</th><td class="text-end fw-semibold" id="previewGrossValue">0</td></tr>
                            <tr><th>Discount value</th><td class="text-end fw-semibold" id="previewDiscountValue">0</td></tr>
                            <tr><th>Net value</th><td class="text-end fw-semibold" id="previewNetValue">0</td></tr>
                        </tbody></table></div>
                        <div class="form-text mt-2">Totals include only valid rows. Missing gross or net values are derived from quantity, unit price, and discount when possible.</div>
                    </div>
                </div>
                <h6>Affected reporting weeks</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered">
                        <thead><tr><th>Week (Monday–Sunday)</th><th class="text-end">Rows</th></tr></thead>
                        <tbody id="previewWeeks"></tbody>
                    </table>
                </div>
                <div id="previewReplacementContainer" class="d-none">
                    <h6 class="text-warning">What this replaces</h6>
                    <p id="previewReplacementSummary" class="mb-2"></p>
                    <ul id="previewReplaces" class="mb-3"></ul>
                </div>
                <div id="previewSkippedContainer" class="d-none">
                    <h6 class="text-warning">Baris bermasalah</h6>
                    <p id="previewSkippedNote" class="small text-muted mb-2"></p>
                    <ul id="previewSkipped" class="mb-3"></ul>
                </div>
                <div id="previewErrorsContainer" class="d-none">
                    <h6 class="text-danger">Validation errors</h6>
                    <ul id="previewErrors" class="mb-0"></ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="confirmSelloutUpload"><span class="ri-upload-2-fill me-1"></span>Confirm and upload</button>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/datatables-bs5/datatables.bootstrap5.js"></script>
    <script src="/lib/moment/moment.js"></script>
    <script src="/js/helper.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        const token = $('input[name="__RequestVerificationToken"]').first().val();

        $(document).ready(function() {
            const yearSelect = $('#yearSelect');
            const monthSelect = $('#monthSelect');
            const uploadForm = document.getElementById('selloutUploadForm');
            const uploadButton = document.getElementById('fileInputAddon');
            const previewModalElement = document.getElementById('selloutUploadPreviewModal');
            const previewModal = previewModalElement ? new bootstrap.Modal(previewModalElement) : null;
            const numberFormatter = new Intl.NumberFormat(undefined, { maximumFractionDigits: 2 });
            let lastSalesQuery = {};
            let salesSummaryRequest = 0;
            let table;

            async function refreshSalesSummary(query) {
                    try {
                        const requestId = ++salesSummaryRequest;
                        const parameters = new URLSearchParams(Object.entries(query).filter(([, value]) => value !== null && value !== undefined && value !== ''));
                        const response = await fetch(`/api/SalesTransactions/Summary?${parameters}`);
                        const payload = await response.json(); if (requestId !== salesSummaryRequest) return; const data = payload.data;
                        if (!response.ok || !data) throw new Error(payload.message || 'Summary unavailable');
                        $('#salesSummaryDistributors').text(numberFormatter.format(data.distributorCount || 0));
                        $('#salesSummaryRows').text(numberFormatter.format(data.rowCount || 0));
                        $('#salesSummaryQty').text(numberFormatter.format(data.invoiceQty || 0));
                        $('#salesSummaryGross').text(numberFormatter.format(data.grossValue || 0));
                        $('#salesSummaryDiscount').text(numberFormatter.format(data.discountValue || 0));
                        $('#salesSummaryNet').text(numberFormatter.format(data.netValue || 0));
                    } catch { $('#salesSelectionSummary .fw-semibold').text('Unavailable'); }
            }

            function addTextRow(target, cells) {
                const row = document.createElement('tr');
                cells.forEach((value, index) => {
                    const cell = document.createElement('td');
                    cell.textContent = value;
                    if (index === cells.length - 1) cell.classList.add('text-end');
                    row.appendChild(cell);
                });
                target.appendChild(row);
            }

            function dateOnly(value) {
                return value ? value.substring(0, 10) : '';
            }

            function weekEnd(value) {
                const date = new Date(`${dateOnly(value)}T00:00:00`);
                date.setDate(date.getDate() + 6);
                return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
            }

            function showUploadPreview(response) {
                const data = response.data || {};
                // Tie the confirmation to the workbook that was actually analysed: the server refuses an
                // upload whose bytes do not hash to what the preview reported.
                document.getElementById("confirmedSha256").value = data.fileSha256 || "";
                const errors = [...new Set([...(response.errors || []), ...(data.errors || [])])];
                document.getElementById('previewTotalRows').textContent = numberFormatter.format(data.totalRows || 0);
                document.getElementById('previewValidRows').textContent = numberFormatter.format(data.validRows || 0);
                document.getElementById('previewInvalidRows').textContent = numberFormatter.format(data.invalidRows || 0);
                document.getElementById('previewIgnoredRowCount').textContent = numberFormatter.format(data.ignoredSummaryRowNumbers?.length || 0);
                document.getElementById('previewFileName').textContent = document.getElementById('fileInput')?.files?.[0]?.name || '-';
                document.getElementById('previewMapping').textContent = data.mappingName || 'Not detected';
                document.getElementById('previewIgnoredRows').textContent = data.ignoredSummaryRowNumbers?.length
                    ? data.ignoredSummaryRowNumbers.join(', ') : 'None';
                document.getElementById('previewInvoiceQty').textContent = numberFormatter.format(data.totalInvoiceQty || 0);
                document.getElementById('previewGrossValue').textContent = numberFormatter.format(data.totalGrossValue || 0);
                document.getElementById('previewDiscountValue').textContent = numberFormatter.format(data.totalDiscountValue || 0);
                document.getElementById('previewNetValue').textContent = numberFormatter.format(data.totalNetValue || 0);

                const weeksBody = document.getElementById('previewWeeks');
                weeksBody.replaceChildren();
                (data.weeks || []).forEach(week => addTextRow(weeksBody, [
                    `${dateOnly(week.reportingWeekStart)} – ${weekEnd(week.reportingWeekStart)}`,
                    String(week.rowCount)
                ]));
                if (!(data.weeks || []).length) addTextRow(weeksBody, ['No reporting week detected', '0']);

                const message = document.getElementById('uploadPreviewMessage');
                message.textContent = errors.length
                    ? 'This workbook cannot be uploaded. Fix the problems listed below and preview it again.'
                    : data.isMultiWeek
                        ? 'This workbook spans several reporting weeks. Confirming replaces your published sales for the dates shown under What this replaces.'
                        : 'Confirm the reporting week derived from the workbook invoice dates.';
                message.className = `alert ${errors.length ? 'alert-danger' : data.isMultiWeek ? 'alert-warning' : 'alert-info'}`;

                // Replacement states which published sales confirming overwrites; unlike errors it must not hide Confirm.
                // Everything here comes from the server and is rendered as text, never as HTML.
                const replacement = data.replacement || data.Replacement || null;
                const replaceList = document.getElementById('previewReplaces');
                replaceList.replaceChildren();
                if (replacement) {
                    document.getElementById('previewReplacementSummary').textContent = replacement.summary;
                    const replaces = replacement.replaces || [];
                    replaces.forEach(batch => {
                        const item = document.createElement('li');
                        item.textContent = `Week starting ${dateOnly(batch.reportingWeekStart)}, ${numberFormatter.format(batch.rowCount)} rows, `
                            + `uploaded ${dateOnly(batch.uploadedDate)} by ${batch.uploadedBy} (${batch.originalFileName})`;
                        replaceList.appendChild(item);
                    });
                    if (!replaces.length) {
                        const item = document.createElement('li');
                        item.textContent = 'Nothing is published for these dates yet.';
                        replaceList.appendChild(item);
                    }
                }
                document.getElementById('previewReplacementContainer').classList.toggle('d-none', !replacement);

                const errorContainer = document.getElementById('previewErrorsContainer');
                const errorList = document.getElementById('previewErrors');
                errorList.replaceChildren();
                errors.forEach(error => {
                    const item = document.createElement('li');
                    item.textContent = error;
                    errorList.appendChild(item);
                });
                errorContainer.classList.toggle('d-none', errors.length === 0);

                // Rows below the invalid-row limit are skipped rather than fatal: they are listed here,
                // and Confirm stays available because the rest of the workbook is still published.
                const skipped = data.rowErrorMessages || [];
                const skippedList = document.getElementById('previewSkipped');
                skippedList.replaceChildren();
                skipped.forEach(line => {
                    const item = document.createElement('li');
                    item.textContent = line;
                    skippedList.appendChild(item);
                });
                document.getElementById('previewSkippedNote').textContent = errors.length
                    ? 'Perbaiki baris berikut di file, lalu preview ulang.'
                    : 'Baris berikut tidak akan diupload; baris lainnya tetap diupload. Perbaiki file dan upload ulang bila baris ini perlu masuk.';
                document.getElementById('previewSkippedContainer').classList.toggle('d-none', skipped.length === 0);
                document.getElementById('confirmSelloutUpload').classList.toggle('d-none', errors.length > 0);
                previewModal?.show();
            }

            uploadForm?.addEventListener('submit', async function(event) {
                if (document.getElementById('multiWeekConfirmed').value === 'true') return;
                event.preventDefault();
                if (!uploadForm.reportValidity()) return;
                uploadButton.disabled = true;
                try {
                    const response = await fetch('@Url.Action("PreflightUpload", "SalesTransactions")', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token },
                        body: new FormData(uploadForm)
                    });
                    const payload = await response.json();
                    showUploadPreview(payload);
                } catch {
                    showUploadPreview({ errors: ['The workbook could not be analyzed. Please try again.'] });
                } finally {
                    uploadButton.disabled = false;
                }
            });

            document.getElementById('confirmSelloutUpload')?.addEventListener('click', function() {
                document.getElementById('multiWeekConfirmed').value = 'true';
                this.disabled = true;
                HTMLFormElement.prototype.submit.call(uploadForm);
            });

            document.getElementById('fileInput')?.addEventListener('change', function() {
                document.getElementById('multiWeekConfirmed').value = 'false';
                document.getElementById('confirmedSha256').value = '';
            });

            monthSelect.prop('disabled', true);

            yearSelect.select2({
                placeholder: "Select Year",
                theme: "bootstrap-5",
                allowClear: true,
                ajax: {
                    url: '/api/SalesTransactions/SelectPeriods',
                    type: 'GET',
                    dataType: 'json',
                    delay: 500,
                    headers: { 'RequestVerificationToken': token },
                    processResults: function (data) {
                        const years = [...new Set(data.data.map(item => item.year))];
                        return {
                            results: years.map(year => ({ id: year, text: year.toString() }))
                        };
                    }
                }
            });
            yearSelect.val(null).trigger('change');

            monthSelect.select2({
                placeholder: "Select Month",
                theme: "bootstrap-5",
                allowClear: true,
                ajax: {
                    url: '/api/SalesTransactions/SelectPeriods',
                    type: 'GET',
                    dataType: 'json',
                    delay: 500,
                    headers: { 'RequestVerificationToken': token },
                    processResults: function (data) {
                        let months = [];
                        const year = yearSelect.val();
                        if (year) {
                            months = data.data
                                .filter(item => item.year === parseInt(year))
                                .map(item => item.month);
                        }
                        months = [...new Set(months)];
                        return {
                            results: months.map(month => ({
                                id: month,
                                text: moment().month(month - 1).format('MMMM')
                            }))
                        };
                    }
                }
            });
            monthSelect.val(null).trigger('change');

            function canLoadTable() {
                return yearSelect.val() && monthSelect.val();
            }

            function getRefreshButton() {
                return {
                    text: '<i class="ri-refresh-line"></i> Refresh',
                    className: 'btn btn-outline-primary',
                    action: function (e, dt, node, config) { dt.ajax.reload(); },
                    titleAttr: 'Refresh Table'
                };
            }

            function getDownloadButton() {
                return {
                    text: '<i class="ri-download-2-fill me-1"></i> Download',
                    className: 'btn btn-outline-primary',
                    action: function (e, dt, node, config) {
                        const year = yearSelect.val();
                        const month = monthSelect.val();
                        if (year && month) {
                            window.location.href = `/SalesTransactions/DownloadSelectByCustPeriod?year=${year}&month=${month}`;
                        } else {
                            alert('Please select both Year and Month before downloading.');
                        }
                    }
                };
            }

            function loadTable() {
                if (table) {
                    table.ajax.reload();
                    return;
                }
                table = $('#salestransaction-table').DataTable({
                    searchDelay: 1000,
                    destroy: true,
                    layout: {
                        topStart: {
                            rowClass: "row m-3 mx-2 my-0 justify-content-between",
                            features: [{ pageLength: { menu: [10, 25, 50, 100], text: "Show_MENU_entries" } }]
                        },
                        topEnd: {
                            buttons: {
                                dom: { container: { className: 'btn-group' } },
                                buttons: [getRefreshButton(), getDownloadButton()]
                            }
                        },
                        bottomStart: {
                            rowClass: "row mx-3 justify-content-between",
                            features: ["info"]
                        },
                        bottomEnd: "paging"
                    },
                    order: [[0, 'asc']],
                    processing: true,
                    paging: true,
                    serverSide: true,
                    searching: true,
                    ordering: true,
                    autoWidth: false,
                    scrollX: true,
                    ajax: {
                        url: '/api/SalesTransactions/Select',
                        data: function(d) {
                            const query = {
                                pageNumber: (d.start / d.length) + 1,
                                pageSize: d.length,
                            };
                            if (d.search && d.search.value) {
                                query.SearchTerm = d.search.value;
                            }
                            if (d.order && d.order.length) {
                                query.SortBy = d.columns[d.order[0].column].data;
                                query.IsSortAscending = d.order[0].dir === 'asc';
                            }
                            d.columns.forEach((column) => {
                                if (column.search && column.search.value) {
                                    query[`Filters.${column.data.charAt(0).toUpperCase() + column.data.slice(1)}`] = column.search.value;
                                }
                            });
                            query['Filters.Year'] = yearSelect.val();
                            query['Filters.Month'] = monthSelect.val();
                            lastSalesQuery = query;
                            return query;
                        },
                        beforeSend: function(xhr) {
                            xhr.setRequestHeader("RequestVerificationToken", token);
                        },
                        dataSrc: function(json) {
                            if (!canLoadTable()) return [];
                            if (json.data && Array.isArray(json.data.items)) {
                                refreshSalesSummary(lastSalesQuery);
                                json.recordsTotal = json.data.totalCount;
                                json.recordsFiltered = json.data.totalCount;
                                return json.data.items;
                            }
                            return json;
                        },
                        error: function(err) {
                            alert(err.responseJSON?.errorMessage || "An error occurred while fetching data");
                        }
                    },
                    columns: [
                        @if (User.IsInRole("Administrator")) { <text>{ data: 'companyName', width: '160px' },</text> }
                        { data: 'invoiceNo', width: '120px' },
                        {
                            data: 'invoiceDate', width: '120px',
                            render: function(data) { return data ? moment(data).format('DD MMM YYYY') : ''; }
                        },
                        { data: 'customerId', width: '100px' },
                        { data: 'customerName' },
                        { data: 'productId', width: '100px' },
                        { data: 'productBrand', width: '120px' },
                        { data: 'productName' },
                        { data: 'productPackaging', width: '120px' },
                        { data: 'batchNumber', width: '100px' },
                        {
                            data: 'expiredDate', width: '120px',
                            render: function(data) { return data ? moment(data).format('DD MMM YYYY') : ''; }
                        },
                        {
                            data: 'invoiceQty', width: '100px',
                            render: function(data) { return data ? numberFormat2Decimals.format(data) : ''; }
                        },
                        { data: 'invoiceUnit', width: '80px' },
                        {
                            data: 'unitPrice', width: '110px',
                            render: function(data) { return data ? numberFormat2Decimals.format(data) : ''; }
                        },
                        {
                            data: 'grossValue', width: '110px',
                            render: function(data) { return data ? numberFormat2Decimals.format(data) : ''; }
                        },
                        {
                            data: 'discountValue', width: '110px',
                            render: function(data) { return data ? numberFormat2Decimals.format(data) : ''; }
                        },
                        {
                            data: 'discountPct', width: '90px',
                            render: function(data) { return data ? numberFormat2Decimals.format(data) : ''; }
                        },
                        {
                            data: 'netValue', width: '110px',
                            render: function(data) { return data ? numberFormat2Decimals.format(data) : ''; }
                        },
                        {
                            data: 'inKg', width: '90px',
                            render: function(data) { return data ? numberFormat2Decimals.format(data) : ''; }
                        },
                        {
                            data: 'shipDate', width: '120px',
                            render: function(data) { return data ? moment(data).format('DD MMM YYYY') : ''; }
                        },
                        { data: 'salesmanNameGMK' }
                    ],
                    columnDefs: [
                        { targets: @Html.Raw(User.IsInRole("Administrator") ? "[1, 2, 3, 5, 9, 10, 12, 19]" : "[0, 1, 2, 4, 8, 9, 11, 18]"), className: 'text-center' }
                    ],
                    initComplete: function () {
                        $('.dt-layout-table').removeClass('mt-2');
                        $(".card-header").after('<hr class="my-0">');
                        $(".dt-buttons").children().removeClass("btn-secondary");
                        this.api().columns().every(function () {
                            let column = this;
                            let title = column.footer().textContent;
                            let input = document.createElement('input');
                            input.placeholder = title;
                            input.className = "form-control form-control-sm";
                            input.style.width = '100%';
                            column.footer().replaceChildren(input);
                            column.footer().style.padding = '8px 4px';
                            input.addEventListener('keyup', debounce(() => {
                                if (column.search() !== input.value) {
                                    column.search(input.value).draw();
                                }
                            }, 1000));
                        });
                    }
                });
            }

            function showOrHideTable() {
                if (canLoadTable()) {
                    $('.card-datatable').show();
                } else {
                    $('.card-datatable').hide();
                }
            }

            yearSelect.on('change', function() {
                if (yearSelect.val()) {
                    monthSelect.prop('disabled', false);
                    monthSelect.val(null).trigger('change');
                } else {
                    monthSelect.prop('disabled', true);
                    monthSelect.val(null).trigger('change');
                }
                showOrHideTable();
                if (canLoadTable()) {
                    if (!table) loadTable();
                    else table.ajax.reload();
                } else if (table) {
                    table.clear().draw();
                }
            });

            monthSelect.on('change', function() {
                showOrHideTable();
                if (canLoadTable()) {
                    if (!table) loadTable();
                    else table.ajax.reload();
                } else if (table) {
                    table.clear().draw();
                }
            });

            showOrHideTable();
        });
    </script>
}
