@model GiselX.Web.Models.PowerBiReportEditViewModel

@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit Power BI Report" : "Add Power BI Report";
    Layout = "_ContentNavbarLayout";
}

<div class="card">
    <div class="card-header"><h5 class="mb-0">@ViewData["Title"]</h5></div>
    <div class="card-body">
        <form asp-action="Save" method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="CompanyId" class="form-label"></label>
                <select asp-for="CompanyId" class="form-select" required>
                    <option value="0">Select a company</option>
                    @foreach (var company in Model.Companies)
                    {
                        <option value="@company.Id">@company.Name</option>
                    }
                </select>
                <span asp-validation-for="CompanyId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="alert alert-warning" role="alert">
              Publish to web is public. Anyone with this URL can view the report and may access underlying detail data. Add only data approved for public Internet access.
            </div>
            <div class="mb-3">
                <label asp-for="EmbedUrl" class="form-label"></label>
                <input asp-for="EmbedUrl" class="form-control" type="url" inputmode="url" required />
                <span asp-validation-for="EmbedUrl" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DisplayOrder" class="form-label"></label>
                <input asp-for="DisplayOrder" class="form-control" type="number" min="0" required />
                <span asp-validation-for="DisplayOrder" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-primary">Save report</button>
            <a asp-action="Index" asp-route-companyId="@Model.CompanyId" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
