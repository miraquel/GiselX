@using GiselX.Service.Dto
@model GiselX.Web.Models.MappingCopyViewModel
@{
    ViewData["Title"] = "Copy Mappings";
    Layout = "_ContentNavbarLayout";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-1">Copy Mappings</h5>
            <small class="text-muted">Copy template and item mappings from another company into <strong>@Model.TargetCompanyName</strong>. Nothing this company already has is changed.</small>
        </div>
        <a asp-controller="Companies" asp-action="Edit" asp-route-id="@Model.TargetCompanyId" class="btn btn-outline-secondary">Back</a>
    </div>
    <div class="card-body">
        @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }

        <form method="get" asp-action="Index" class="row g-2 align-items-end mb-4">
            <input type="hidden" name="companyId" value="@Model.TargetCompanyId" />
            <div class="col-md-6">
                <label for="sourceCompanyId" class="form-label">Copy from</label>
                <select id="sourceCompanyId" name="sourceCompanyId" class="form-select" onchange="this.form.submit()">
                    <option value="">Choose a company…</option>
                    @foreach (var source in Model.Sources)
                    {
                        <option value="@source.Id" selected="@(source.Id == Model.SourceCompanyId)">@source.DisplayName</option>
                    }
                </select>
            </div>
            <div class="col-auto"><button class="btn btn-outline-primary">Show mappings</button></div>
        </form>

        @if (Model.Preview is { } preview)
        {
            <form method="post" asp-action="Copy">
                <input type="hidden" name="companyId" value="@Model.TargetCompanyId" />
                <input type="hidden" name="sourceCompanyId" value="@preview.SourceCompanyId" />

                @if (Model.CanCopySellout)
                {
                    <h6 class="mt-2">Sellout template mappings</h6>
                    <partial name="_TemplateCandidates" model="@(new Tuple<string, IReadOnlyList<TemplateCopyCandidateDto>>("selloutMappingIds", preview.SelloutTemplates))" />
                }

                @if (Model.CanCopyStock)
                {
                    <h6 class="mt-4">Stock template mappings</h6>
                    <partial name="_TemplateCandidates" model="@(new Tuple<string, IReadOnlyList<TemplateCopyCandidateDto>>("stockMappingIds", preview.StockTemplates))" />
                }

                @if (Model.CanCopyItems)
                {
                    <h6 class="mt-4">Item mappings</h6>
                    @if (!preview.TargetItemMappingEnabled)
                    {
                        <div class="alert alert-warning">Item mapping is disabled for this company; copied item mappings take effect once it is enabled on the company screen.</div>
                    }
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="copyItemMappings" name="copyItemMappings" value="true"
                               checked="@(preview.ItemMappingsToCopy > 0)" disabled="@(preview.ItemMappingsToCopy == 0)" />
                        <label class="form-check-label" for="copyItemMappings">
                            Copy item mappings — <strong>@preview.ItemMappingsToCopy</strong> to copy,
                            @preview.ItemMappingsSkipped skipped because this company already maps that Distributor Item ID.
                        </label>
                    </div>
                }

                <div class="mt-4">
                    <button class="btn btn-primary" onclick="return confirm('Copy the selected mappings into this company?');">Copy selected</button>
                </div>
            </form>
        }
    </div>
</div>
