@{
    ViewData["Title"] = "Test Email Notification";
    Layout = "_ContentNavbarLayout";
}

@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["StatusMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="mb-0">Test Email Notification</h5>
        <small class="text-muted float-end">Send a test reminder email to verify SMTP configuration</small>
    </div>
    <div class="card-body">
        <form asp-action="Send" method="post">
            @Html.AntiForgeryToken()

            <div class="row mb-4">
                <label for="toEmail" class="col-sm-3 col-form-label">Recipient Email</label>
                <div class="col-sm-9">
                    <input type="email" id="toEmail" name="toEmail" class="form-control"
                           value="@ViewBag.ToEmail" placeholder="recipient@example.com" required />
                    <small class="text-muted">The email address that will receive the test message.</small>
                </div>
            </div>

            <div class="row mb-4">
                <label for="companyName" class="col-sm-3 col-form-label">Company Name</label>
                <div class="col-sm-9">
                    <input type="text" id="companyName" name="companyName" class="form-control"
                           placeholder="e.g. PT Maju Jaya" required />
                    <small class="text-muted">Used to personalise the email subject and body.</small>
                </div>
            </div>

            <div class="row mb-4">
                <label for="deadline" class="col-sm-3 col-form-label">Deadline Date</label>
                <div class="col-sm-9">
                    <input type="date" id="deadline" name="deadline" class="form-control"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
            </div>

            <div class="row mb-4">
                <label class="col-sm-3 col-form-label">Reminder Type</label>
                <div class="col-sm-9 pt-2">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="isFinalReminder"
                               id="typeEarly" value="false" checked />
                        <label class="form-check-label" for="typeEarly">
                            Early Warning
                            <small class="text-muted d-block">Subject: [Reminder] Data upload due in N days</small>
                        </label>
                    </div>
                    <div class="form-check form-check-inline ms-4">
                        <input class="form-check-input" type="radio" name="isFinalReminder"
                               id="typeFinal" value="true" />
                        <label class="form-check-label" for="typeFinal">
                            Final Reminder
                            <small class="text-muted d-block">Subject: [Action Required] Deadline is today</small>
                        </label>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-9 offset-sm-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="ri-mail-send-line me-1"></i> Send Test Email
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
