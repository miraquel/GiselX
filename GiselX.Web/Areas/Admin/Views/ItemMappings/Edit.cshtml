@model GiselX.Web.Models.ItemMappingEditViewModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit Item Mapping" : "Add Item Mapping";
    Layout = "_ContentNavbarLayout";
}

<div class="card">
    <div class="card-header"><h5 class="mb-0">@ViewData["Title"]</h5></div>
    <div class="card-body">
        <form asp-action="Save" method="post">
            <input asp-for="Id" type="hidden" />
            <input asp-for="CompanyId" type="hidden" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="row">
                <div class="col-md-6 mb-3"><label asp-for="GmkItemId" class="form-label"></label><input asp-for="GmkItemId" class="form-control" required /><span asp-validation-for="GmkItemId" class="text-danger"></span></div>
                <div class="col-md-6 mb-3"><label asp-for="GmkItemName" class="form-label"></label><input asp-for="GmkItemName" class="form-control" required /><span asp-validation-for="GmkItemName" class="text-danger"></span></div>
                <div class="col-md-6 mb-3"><label asp-for="DistributorItemId" class="form-label"></label><input asp-for="DistributorItemId" class="form-control" required /><span asp-validation-for="DistributorItemId" class="text-danger"></span></div>
                <div class="col-md-6 mb-3"><label asp-for="DistributorItemName" class="form-label"></label><input asp-for="DistributorItemName" class="form-control" required /><span asp-validation-for="DistributorItemName" class="text-danger"></span></div>
            </div>
            <button type="submit" class="btn btn-primary">Save Mapping</button>
            <a asp-action="Index" asp-route-companyId="@Model.CompanyId" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
