@model IReadOnlyList<GiselX.Service.Dto.BusinessUnitDto>
@{
    ViewData["Title"] = "Business Units";
    Layout = "_ContentNavbarLayout";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-1">Business Unit Master</h5>
            <small class="text-muted">Manage the Business Units available when creating or editing companies.</small>
        </div>
        <a asp-action="Create" class="btn btn-primary">Add Business Unit</a>
    </div>
    <div class="card-body">
        @if (TempData["StatusMessage"] is string status)
        {
            <div class="alert alert-success">@status</div>
        }
        @if (TempData["ErrorMessage"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>No</th><th>Name</th><th>Status</th><th>Actions</th></tr></thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="text-muted">No Business Units have been added.</td></tr>
                }
                else
                {
                    @for (var index = 0; index < Model.Count; index++)
                    {
                        var value = Model[index];
                        <tr>
                            <td>@(index + 1)</td>
                            <td>@value.Name</td>
                            <td><span class="badge @(value.IsActive ? "bg-success" : "bg-secondary")">@(value.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-nowrap">
                                <a asp-action="Edit" asp-route-id="@value.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <form asp-action="@(value.IsActive ? "Deactivate" : "Activate")" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@value.Id" />
                                    <button class="btn btn-sm btn-outline-secondary">@(value.IsActive ? "Deactivate" : "Activate")</button>
                                </form>
                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this unused Business Unit?');">
                                    <input type="hidden" name="id" value="@value.Id" />
                                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
