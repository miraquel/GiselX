@using GiselX.Domain
@using GiselX.Web
@model GiselX.Service.Dto.StockUploadBatchDto
@{ ViewData["Title"] = "Hasil Upload Stock"; Layout = "_ContentNavbarLayout"; }
<div class="card"><div class="card-header d-flex justify-content-between"><h5>Hasil Upload Stock</h5><a asp-action="Index" class="btn btn-outline-secondary">Kembali ke Stock</a></div><div class="card-body">
    <div class="alert @(Model.Status == StockUploadBatchStatus.Failed ? "alert-danger" : Model.Status == StockUploadBatchStatus.CompletedWithWarnings ? "alert-warning" : "alert-success")">@Model.Message</div>
    <dl class="row"><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@UploadStatusLabels.For(Model.Status)</dd><dt class="col-sm-4">Tanggal stok</dt><dd class="col-sm-8">@Model.StockDate.ToString("dd MMM yyyy")</dd><dt class="col-sm-4">File</dt><dd class="col-sm-8">@Model.OriginalFileName</dd><dt class="col-sm-4">Baris</dt><dd class="col-sm-8">@Model.TotalRows.ToString("N0") total, @Model.ValidRows.ToString("N0") disimpan, @Model.InvalidRows.ToString("N0") tidak valid</dd><dt class="col-sm-4">Diupload</dt><dd class="col-sm-8">@UploadStatusLabels.LocalTime(Model.UploadedDate) oleh @Model.UploadedBy</dd></dl>
    @if (Model.IgnoredSummaryRowNumbers.Count > 0) { <p><strong>Baris total/ringkasan yang diabaikan:</strong> @string.Join(", ", Model.IgnoredSummaryRowNumbers)</p> }
    @if (Model.Errors.Count > 0) { <h6>Detail baris tidak valid</h6><p class="small text-muted">Baris berikut tidak disimpan. Perbaiki di file lalu upload ulang bila baris ini perlu masuk.</p><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Sheet</th><th>Baris</th><th>Kolom</th><th>Alasan</th><th>Isi sel</th></tr></thead><tbody>@foreach(var error in Model.Errors){<tr><td>@error.WorksheetName</td><td>@error.SourceRowNumber</td><td>@error.Field</td><td>@error.Reason</td><td>@error.RejectedValue</td></tr>}</tbody></table></div> }
</div></div>
